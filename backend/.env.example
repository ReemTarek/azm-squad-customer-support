DATABASE_URL="file:./dev.db"
# Target (once SQL Server TCP/IP is enabled): sqlserver://localhost:1433;database=AzmSupportCrm;integratedSecurity=true;trustServerCertificate=true;encrypt=true

JWT_ACCESS_SECRET="replace-with-random-secret"
JWT_REFRESH_SECRET="replace-with-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-2.0-flash"

PORT=4000
NODE_ENV=development
