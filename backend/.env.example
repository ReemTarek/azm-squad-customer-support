DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET="replace-with-random-secret"
JWT_REFRESH_SECRET="replace-with-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

GEMINI_API_KEY="replace-with-your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# Gmail SMTP: generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled). Leave blank to fall back to console logging.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="replace-with-your-gmail-address"
SMTP_PASS="replace-with-your-16-char-app-password"

PORT=4000
NODE_ENV=development
