datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  Admin
  Manager
  Agent
  Customer
}

enum Locale {
  en
  ar
}

enum Priority {
  Low
  Medium
  High
  Urgent
}

enum TicketStatus {
  Open
  InProgress
  Resolved
  Closed
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  name         String
  locale       Locale   @default(en)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile      CustomerProfile?
  ticketsAsCustomer    Ticket[]              @relation("TicketCustomer")
  ticketsAsAgent       Ticket[]              @relation("TicketAgent")
  ticketMessages       TicketMessage[]
  statusChanges        TicketStatusHistory[]
  knowledgeBaseAuthors KnowledgeBaseArticle[]
  auditLogs            AuditLog[]
  ticketTasks          TicketTask[]
  quickReplies         QuickReply[]
  notesAboutMe         CustomerNote[] @relation("CustomerNoteSubject")
  notesAuthored        CustomerNote[] @relation("CustomerNoteAuthor")
}

model CustomerProfile {
  id      String  @id @default(uuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone   String?
  company String?
}

model Ticket {
  id               String   @id @default(uuid())
  customerId       String
  customer         User     @relation("TicketCustomer", fields: [customerId], references: [id])
  assignedAgentId  String?
  assignedAgent    User?    @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  branchId         String?
  branch           Branch?  @relation(fields: [branchId], references: [id])
  subject          String
  category         String   @default("General")
  priority         Priority
  status           TicketStatus @default(Open)
  responseDueAt    DateTime
  resolutionDueAt  DateTime
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  messages       TicketMessage[]
  statusHistory  TicketStatusHistory[]
  feedback       CustomerFeedback?
  tasks          TicketTask[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([departmentId])
  @@index([branchId])
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users   User[]
  tickets Ticket[]
}

model Branch {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users   User[]
  tickets Ticket[]
}

model TicketMessage {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  body           String
  isInternalNote Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([ticketId])
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  changedBy   User          @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now())

  @@index([ticketId])
}

model KnowledgeBaseArticle {
  id        String   @id @default(uuid())
  title     String
  body      String
  category  String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
}

model CustomerFeedback {
  id        String   @id @default(uuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model TicketTask {
  id             String    @id @default(uuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedToId   String
  assignedTo     User      @relation(fields: [assignedToId], references: [id])
  title          String
  dueAt          DateTime?
  completed      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([ticketId])
  @@index([assignedToId])
}

model QuickReply {
  id        String   @id @default(uuid())
  title     String
  body      String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model SlaPolicy {
  id               String   @id @default(uuid())
  priority         Priority @unique
  responseMinutes  Int
  resolutionMinutes Int
  updatedAt        DateTime @updatedAt
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   User     @relation("CustomerNoteSubject", fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id])
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
